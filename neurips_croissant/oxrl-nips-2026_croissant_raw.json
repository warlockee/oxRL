{
  "@context": {
    "@language": "en",
    "@vocab": "https://schema.org/",
    "arrayShape": "cr:arrayShape",
    "citeAs": "cr:citeAs",
    "column": "cr:column",
    "conformsTo": "dct:conformsTo",
    "containedIn": "cr:containedIn",
    "cr": "http://mlcommons.org/croissant/",
    "data": {
      "@id": "cr:data",
      "@type": "@json"
    },
    "dataBiases": "cr:dataBiases",
    "dataCollection": "cr:dataCollection",
    "dataType": {
      "@id": "cr:dataType",
      "@type": "@vocab"
    },
    "dct": "http://purl.org/dc/terms/",
    "extract": "cr:extract",
    "field": "cr:field",
    "fileProperty": "cr:fileProperty",
    "fileObject": "cr:fileObject",
    "fileSet": "cr:fileSet",
    "format": "cr:format",
    "includes": "cr:includes",
    "isArray": "cr:isArray",
    "isLiveDataset": "cr:isLiveDataset",
    "jsonPath": "cr:jsonPath",
    "key": "cr:key",
    "md5": "cr:md5",
    "parentField": "cr:parentField",
    "path": "cr:path",
    "personalSensitiveInformation": "cr:personalSensitiveInformation",
    "recordSet": "cr:recordSet",
    "references": "cr:references",
    "regex": "cr:regex",
    "repeated": "cr:repeated",
    "replace": "cr:replace",
    "sc": "https://schema.org/",
    "separator": "cr:separator",
    "source": "cr:source",
    "subField": "cr:subField",
    "transform": "cr:transform",
    "dataLimitations": "cr:dataLimitations",
    "dataUseCases": "cr:dataUseCases",
    "dataSocialImpact": "cr:dataSocialImpact",
    "hasSyntheticData": "cr:hasSyntheticData"
  },
  "@type": "sc:Dataset",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "repo",
      "name": "repo",
      "description": "The Hugging Face git repository.",
      "contentUrl": "https://huggingface.co/datasets/warlockee/oxrl-nips-2026/tree/refs%2Fconvert%2Fparquet",
      "encodingFormat": "git+https",
      "sha256": "https://github.com/mlcommons/croissant/issues/80"
    },
    {
      "@type": "cr:FileSet",
      "@id": "parquet-files-for-config-default",
      "containedIn": {
        "@id": "repo"
      },
      "encodingFormat": "application/x-parquet",
      "includes": "default/*/*.parquet"
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "dataType": "cr:Split",
      "key": {
        "@id": "default_splits/split_name"
      },
      "@id": "default_splits",
      "name": "default_splits",
      "description": "Splits for the default config.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default_splits/split_name",
          "dataType": "sc:Text"
        }
      ],
      "data": [
        {
          "default_splits/split_name": "train"
        },
        {
          "default_splits/split_name": "test"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "default",
      "description": "warlockee/oxrl-nips-2026 - 'default' subset\n\nAdditional information:\n- 2 splits: train, test",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "default/split",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "fileProperty": "fullpath"
            },
            "transform": {
              "regex": "default/(?:partial-)?(train|test)/.+parquet$"
            }
          },
          "references": {
            "field": {
              "@id": "default_splits/split_name"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/prompt",
          "subField": [
            {
              "@type": "cr:Field",
              "@id": "default/prompt/content",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "prompt"
                },
                "transform": {
                  "jsonPath": "content"
                }
              }
            },
            {
              "@type": "cr:Field",
              "@id": "default/prompt/role",
              "dataType": "sc:Text",
              "source": {
                "fileSet": {
                  "@id": "parquet-files-for-config-default"
                },
                "extract": {
                  "column": "prompt"
                },
                "transform": {
                  "jsonPath": "role"
                }
              }
            }
          ],
          "isArray": true,
          "arrayShape": "-1"
        },
        {
          "@type": "cr:Field",
          "@id": "default/chosen",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "chosen"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/rejected",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "rejected"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/answer",
          "dataType": "sc:Text",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "answer"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/chosen_reward",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "chosen_reward"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "default/rejected_reward",
          "dataType": "cr:Float64",
          "source": {
            "fileSet": {
              "@id": "parquet-files-for-config-default"
            },
            "extract": {
              "column": "rejected_reward"
            }
          }
        }
      ]
    }
  ],
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "name": "oxrl-nips-2026",
  "description": "warlockee/oxrl-nips-2026 dataset hosted on Hugging Face and contributed by the HF Datasets community",
  "alternateName": [
    "warlockee/oxrl-nips-2026"
  ],
  "creator": {
    "@type": "Person",
    "name": "erik li",
    "url": "https://huggingface.co/warlockee"
  },
  "keywords": [
    "100K - 1M",
    "parquet",
    "Tabular",
    "Text",
    "Datasets",
    "Dask",
    "Polars",
    "Croissant",
    "\ud83c\uddfa\ud83c\uddf8 Region: US"
  ],
  "url": "https://huggingface.co/datasets/warlockee/oxrl-nips-2026",
  "cr:dataLimitations": "Dataset covers mathematical reasoning (GSM8K) only; English language; model-generated responses may contain factual errors. Results from models trained on this data may not generalise to other reasoning tasks or languages.",
  "cr:dataBiases": "Derived from GSM8K (grade-school arithmetic); inherits topic and difficulty biases of that benchmark. Model-generated self-play data reflects the biases of the source models (Qwen 2.5, Gemma 3 Instruct checkpoints).",
  "cr:personalSensitiveInformation": "None. Dataset contains only math problem prompts and model-generated responses; no personal or sensitive information is present.",
  "cr:dataUseCases": "Training and evaluating post-training algorithms (SP-RFT, DPO, SimPO, GRPO variants) for mathematical reasoning; reproducing NeurIPS 2026 paper results.",
  "cr:dataSocialImpact": "Enables reproducible benchmarking of post-training algorithms at multiple scales. May lower barriers to fine-tuning capable math-reasoning models; practitioners should validate at deployment scale before drawing algorithmic conclusions.",
  "cr:hasSyntheticData": true
}